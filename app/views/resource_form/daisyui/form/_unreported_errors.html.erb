<%# Renders when validation errors exist on attributes that no f.field rendered.
    Typical cause: hidden_field validation errors, or errors on attributes the
    developer forgot to include in the form. %>
<div class="alert alert-error mb-3" role="alert">
  <div class="flex flex-col gap-1 w-full">
    <div class="font-semibold"><%= t("resource_form.errors.unreported_heading", default: "Er zijn problemen die niet zichtbaar zijn in het formulier:") %></div>
    <ul class="list-disc ml-5 text-sm">
      <% errors.each do |err| %>
        <li><%= err.full_message %></li>
      <% end %>
    </ul>
  </div>
</div>
