<%
  collection = spec[:collection] || spec[:values] || []
  label_method = spec[:label_method]
  value_method = spec[:value_method]
  selected_value = f.object.respond_to?(name) ? f.object.send(name) : nil

  select_options = {}
  if spec.key?(:prompt)
    select_options[:prompt] = spec[:prompt]
  else
    select_options[:include_blank] = spec.fetch(:include_blank, true)
  end

  option_tags = if label_method && value_method
    options_from_collection_for_select(collection, value_method, label_method, selected_value)
  else
    options_for_select(collection, selected_value)
  end
%>
<%= f.select name,
      option_tags,
      select_options,
      class: "select select-sm w-full #{'select-error' if error}",
      required: spec[:required],
      disabled: spec[:disabled] %>
