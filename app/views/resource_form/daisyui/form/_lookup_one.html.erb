<%
  # Associations: attribute is the association name, FK is :#{name}_id
  association = f.object.class.reflect_on_association(name)
  fk_name = association ? association.foreign_key.to_sym : name
  selected_id = f.object.send(fk_name)
  selected_object = association ? f.object.send(name) : nil

  label_method = spec[:label_method]
  selected_label = ResourceForm.lookup_label(selected_object, label_method: label_method)

  preselected_options = selected_object ? [[selected_label, selected_id]] : []
  url = spec[:url]
%>
<%= f.select fk_name,
      options_for_select(preselected_options, selected_id),
      { include_blank: spec.fetch(:include_blank, true) },
      class: "select select-sm w-full #{'select-error' if error}",
      data: {
        controller: "tom-select",
        tom_select_url_value: url,
        tom_select_placeholder_value: spec[:placeholder]
      },
      disabled: spec[:disabled] %>
